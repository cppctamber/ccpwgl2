# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Dependency directories
node_modules/

# IDE
.idea/
.vscode/settings.json
.claude/settings.local.json

# Local caches and working directories
.cache/
.npm-cache/
.npm-cache-docs/
.promotion-runtime-trinity/
.scratch/
.skill-work/
.tmp/
_kb_stage/

# Agent runtime state and work-cycle notes
.claude/
.codex/

# Local prepared character-library review payloads
demo/character/library.review.json
demo/character/library.short-hair-review.json

# Local demos and character integration proofs
/demo/

# dotenv environment variables file
.env

# developement
_dev/
_internal/
_review/
_res/
twitch_emotes/

# legacy local resources
res/
_shaders/
_twitch_emotes/

# wrapped client implementation should stay local for now
src/wrapped/

# experimental rollup build output
dist/rollup/

# local experiments
src/experiments/
public/carbon/

# Scratch build and tooling output, plus artifacts/notes - the working notes and
# findings for whatever is in flight. Notes expire when their work lands: promote
# verified durable CCPWGL content to the local docs/ tree, then delete the
# scratch copy.
artifacts/

# test fixtures containing real extracted CCP/EVE game assets (.black, .sm_hi,
# and the webgl effect packages built from them) - not safe to commit
test/fixtures/

# Working notes stay local - durable CCPWGL content belongs in docs/
NOTES-*.md
src/**/README.md

# Agent entry files: generated per checkout, never committed
/CLAUDE.md
/AGENTS.md

# Guards against notes landing back in the root rather than artifacts/notes
AGENT-*.md
PLAN-*.md

# CCPWGL documentation stays local; do not commit or push it.
docs/

# Local test and tooling scripts. Untracked deliberately: package.json still
# carries the `test:*` entries that run them, so they work in this checkout but
# a fresh clone will not have the files those entries point at.
scripts/

# Scratch harnesses that need external state (a fetched asset, a running
# service) so they cannot join the test sweep
*.local.js
*.local.mjs
*.local.cjs
